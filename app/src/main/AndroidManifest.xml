<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <queries>
        <package android:name="com.fatsecret.android" />
    </queries>

    <application
        android:name=".LifeApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="LifeAPI"
        android:supportsRtl="true"
        android:theme="@style/Theme.LifeAPI">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- FatSecret OAuth return: lifeapi://fatsecret/callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lifeapi" android:host="fatsecret" />
            </intent-filter>
            <!-- Enable Banking return (via the bank proxy): lifeapi://bank/callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="lifeapi" android:host="bank" />
            </intent-filter>
        </activity>

        <!-- Local reminders -->
        <receiver android:name=".notify.ReminderReceiver" android:exported="false" />
        <receiver android:name=".notify.ReminderBootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Home screen widgets (Glance) -->
        <receiver android:name=".widget.DayScoreReceiver" android:exported="true" android:label="@string/widget_dayscore_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_dayscore_info" />
        </receiver>
        <receiver android:name=".widget.SupplementsReceiver" android:exported="true" android:label="@string/widget_supplements_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_supplements_info" />
        </receiver>
        <receiver android:name=".widget.WaterReceiver" android:exported="true" android:label="@string/widget_water_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_water_info" />
        </receiver>
        <receiver android:name=".widget.ProjectReceiver" android:exported="true" android:label="@string/widget_project_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_project_info" />
        </receiver>
        <receiver android:name=".widget.TasksReceiver" android:exported="true" android:label="@string/widget_tasks_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_tasks_info" />
        </receiver>
        <receiver android:name=".widget.WorkoutReceiver" android:exported="true" android:label="@string/widget_workout_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_workout_info" />
        </receiver>
        <receiver android:name=".widget.FinanceReceiver" android:exported="true" android:label="@string/widget_finance_label">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE" /></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_finance_info" />
        </receiver>
        <!-- Pre-download the ML Kit barcode scanner UI module from Play services at install time. -->
    </application>
</manifest>
